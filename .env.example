APP_ENV=development
JWT_SECRET=replace-with-long-random-secret-at-least-32-chars
DATABASE_URL=postgres://investiq:investiq@localhost:5432/investiq
REDIS_URL=redis://127.0.0.1:6379
HOST=0.0.0.0
PORT=8080
RUST_LOG=investiq_api=info,tower_http=info
AI_API_KEY=
AI_BASE_URL=https://api.x.ai/v1
AI_MODEL=grok-2-latest
AES_KEY_BASE64=
JWT_ACCESS_TTL_SECS=900
JWT_REFRESH_TTL_SECS=2592000
RATE_LIMIT_RPS=30
CORS_ORIGINS=*
# Google / Firebase Auth (required for Continue with Google)
# Full steps: CONFIGURATION_REQUIRED.md
# Firebase Project ID (token aud for Firebase ID tokens)
FIREBASE_PROJECT_ID=
# Comma-separated OAuth client IDs (Web + Android) for Google ID token aud
GOOGLE_CLIENT_IDS=
# How often to pull IPO data from NSE (seconds)
IPO_SYNC_INTERVAL_SECS=1800
IPO_LIST_CACHE_TTL_SECS=120
